// Граматика SIPL у форматі Lark (EBNF).
// Відповідає БНФ з практикуму (практична 1):
//   <програма> ::= begin <оператор> end
//   <оператор> ::= x := a | S1 ; S2 | if b then S1 else S2 | while b do S | begin S end | skip
//   <вираз>    ::= n | x | a1 + a2 | a1 - a2 | a1 * a2 | (a)
//   <умова>    ::= true | false | a1 < a2 | a1 = a2 | a1 > a2 | not b | b1 and b2 | b1 or b2 | (b)
// Розширення SIPL+ (як у варіантах завдань): div, mod, <=, >=, <>, коментарі //.
// Нижче такі правила позначені "[SIPL+]", все інше - база.
//
// Тут пріоритети записані явно, щоб граматика була однозначна:
//   ';' слабше за if/while, вирази: * div mod сильніше за + -, умови: not > and > or.
// Цей файл перевіряється тестом tests/test_grammar.py на тих самих прикладах, що й парсер.

?start: program

program: "begin" stmts "end"

?stmts: stmt
      | stmts ";" stmt            -> seq

?stmt: NAME ":=" aexpr            -> assign
     | "if" bexpr "then" stmt "else" stmt   -> if_
     | "while" bexpr "do" stmt    -> while_
     | "begin" stmts "end"        -> block
     | "skip"                     -> skip

?aexpr: term
      | aexpr "+" term            -> add
      | aexpr "-" term            -> sub

?term: factor
     | term "*" factor            -> mult
     | term "div" factor          -> div      // [SIPL+]
     | term "mod" factor          -> mod      // [SIPL+]

?factor: NUMBER                   -> num
       | NAME                     -> var
       | "(" aexpr ")"

?bexpr: bterm
      | bexpr "or" bterm          -> or_
?bterm: bfactor
      | bterm "and" bfactor       -> and_
?bfactor: "not" bfactor           -> not_
        | "true"                  -> true
        | "false"                 -> false
        | aexpr CMP aexpr         -> cmp
        | "(" bexpr ")"

CMP: "<=" | ">=" | "<>" | "<" | ">" | "="   // "<=", ">=", "<>" - [SIPL+]
NAME: /(?!(begin|end|if|then|else|while|do|skip|true|false|and|or|not|div|mod)\b)[A-Za-z_][A-Za-z0-9_]*/
NUMBER: /[0-9]+/
COMMENT: /\/\/[^\n]*/                        // [SIPL+]

%import common.WS
%ignore WS
%ignore COMMENT
