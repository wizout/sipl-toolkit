?start: program

program: "begin" stmts "end"

?stmts: stmt
      | stmts ";" stmt -> seq

?stmt: NAME ":=" aexpr -> assign
     | "if" bexpr "then" stmt "else" stmt -> if_
     | "while" bexpr "do" stmt -> while_
     | "begin" stmts "end" -> block
     | "skip" -> skip

?aexpr: term
      | aexpr "+" term -> add
      | aexpr "-" term -> sub

?term: factor
     | term "*" factor -> mult
     | term "div" factor -> div
     | term "mod" factor -> mod

?factor: NUMBER -> num
       | NAME -> var
       | "(" aexpr ")"

?bexpr: bterm
      | bexpr "or" bterm -> or_
?bterm: bfactor
      | bterm "and" bfactor -> and_
?bfactor: "not" bfactor -> not_
        | "true" -> true
        | "false" -> false
        | aexpr CMP aexpr -> cmp
        | "(" bexpr ")"

CMP: "<=" | ">=" | "<>" | "<" | ">" | "="
NAME: /(?!(begin|end|if|then|else|while|do|skip|true|false|and|or|not|div|mod)\b)[A-Za-z_][A-Za-z0-9_]*/
NUMBER: /[0-9]+/
COMMENT: /\/\/[^\n]*/

%import common.WS
%ignore WS
%ignore COMMENT
